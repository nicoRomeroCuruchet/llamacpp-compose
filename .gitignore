# Models NEVER go into the repo: they are tens of GB and are fetched with
# scripts/download-model.sh. Git is the wrong tool for this.
*.gguf
models/

# Per-machine configuration, not the repo's. The versioned reference is
# .env.example.
.env

*.log

# Runtime files from scripts/serve-metal.sh, which manages a process
# rather than a container.
*.pid

# Backups left by in-place doc edits. Not history; git is.
*.pre-experiments

# Byte-compiled Python. scripts/gguf-info.py is stdlib-only and needs no
# build step; these appear when the CI checks are run locally.
__pycache__/
*.pyc
