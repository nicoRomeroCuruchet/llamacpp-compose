# Copy to .env and adjust.  cp .env.example .env
# .env is in .gitignore: it is this machine's configuration, not the repo's.

# --- Where the .gguf files live on the host ---
# Mounted read-only at /models inside the container.
MODELS_DIR=/home/nromero/models

# --- Model ---
# File name INSIDE MODELS_DIR (not the full path).
MODEL_FILE=Qwen3.8-27B-UD-Q4_K_XL.gguf
# The name clients see in /v1/models. Keep it distinct per machine: if two
# servers share an alias, there is no way to tell which one answered.
MODEL_ALIAS=qwen38-27b

CONTAINER_NAME=qwen
PORT=8080

# --- Memory ---
# Context window. This is the first thing to lower when the model does not fit
# in VRAM. The arithmetic is in the README.
CTX=65536
# Layers offloaded to the GPU. "all" means every one of them. A number sends the
# rest to the CPU: it works, but it is slow.
NGL=all
# KV cache quantization: q8_0 uses half of what f16 does, at negligible loss.
# Applies to both K and V unless one of the two below overrides it.
KV_TYPE=q8_0
# K and V are not equally sensitive. Quantizing K hurts long-context retrieval
# noticeably; V tolerates q4_0 much better. So KV_TYPE_V=q4_0 with K left at
# q8_0 buys ~25% off the KV cache for little quality — which shows up twice:
# less VRAM per token of context, and smaller entries in the host-RAM prompt
# cache, so fewer conversations get evicted and reprocessed from scratch.
# Leave both unset to follow KV_TYPE.
#KV_TYPE_K=q8_0
#KV_TYPE_V=q4_0

# --- Sampling ---
# These are the values recommended for Qwen3. CAREFUL: they are model-specific.
# Ornith 1.0 35B, for instance, wants --temp 1.0 --top-k 0. Do not copy them
# between models without checking the model card.
TEMP=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0

# How reasoning is separated from the answer. "deepseek" sends the thinking
# block to a field of its own (reasoning_content) instead of leaving it in
# content.
REASONING_FORMAT=deepseek

# --- Throughput ---
# Host RAM (MiB) for the prompt cache: KV states of past conversations, kept so
# a client that comes back with a prompt it already sent does not pay to have it
# reprocessed. Purely a cache — what it stores is identical to what would be
# recomputed, so it cannot affect output quality, only latency.
# When it is full the server evicts the oldest entry and says so in the log:
#   srv alloc: - making room for prompt cache entry, removing oldest entry
# Size it against `free -g`, not against VRAM: this lives in system RAM, and
# overcommitting it trades a slow prefill for swapping, which is worse. An
# entry costs roughly (context length x KV bytes per token) — ~478 MiB for a
# 49k-token conversation at q8_0.
CACHE_RAM=10240

# Prompt batch sizes. llama.cpp's own defaults are 2048/512; anything lower
# throttles prefill for no benefit once every layer is on the GPU. Lower UBATCH
# only if the compute buffers push you out of VRAM.
BATCH=2048
UBATCH=512

# Speculative decoding. This model ships MTP heads (the blk.N.nextn.* tensors),
# so "draft-mtp" drafts with weights that are already loaded — no second model,
# no extra download. With any other --spec-type those tensors sit in VRAM
# unused and the server logs them as "unused tensor ... ignoring".
# Speculation is lossless: rejected drafts are discarded, so the text is exactly
# what the model would have produced on its own. It only ever costs time.
#   draft-mtp     use the model's own MTP heads (best here)
#   ngram-simple  no weights, drafts by repeating seen n-grams; weak on prose
#   none          disable
SPEC_TYPE=draft-mtp
# Tokens drafted per step. Higher pays off only when acceptance is high; each
# rejected token is wasted compute.
SPEC_N_MAX=8
# Confidence floor for keeping a drafted token. Lower drafts more aggressively.
SPEC_P_MIN=0.7

# The address Docker publishes the port on.
#   127.0.0.1  -> this machine only (the default)
#   <tailscale IP, from `tailscale ip -4`> -> reachable from the whole tailnet
BIND=127.0.0.1
