# Copy to .env and adjust.  cp .env.example .env
# .env is in .gitignore: it is this machine's configuration, not the repo's.

# --- Where the .gguf files live on the host ---
# Mounted read-only at /models inside the container.
MODELS_DIR=/home/nromero/models

# --- Model ---
# File name INSIDE MODELS_DIR (not the full path).
MODEL_FILE=Qwen3.8-27B-UD-Q4_K_XL.gguf
# The name clients see in /v1/models. Keep it distinct per machine: if two
# servers share an alias, there is no way to tell which one answered.
MODEL_ALIAS=qwen38-27b

CONTAINER_NAME=qwen
PORT=8080

# --- Memory ---
# Context window. This is the first thing to lower when the model does not fit
# in VRAM. The arithmetic is in the README.
CTX=65536
# Layers offloaded to the GPU. "all" means every one of them. A number sends the
# rest to the CPU: it works, but it is slow.
NGL=all
# MoE expert offload: keep the expert tensors of the first N blocks in host RAM
# rather than in VRAM. 0 offloads nothing and is the right value for a dense
# model or any model that already fits.
#
# On a MIXTURE OF EXPERTS it is the difference between "does not fit" and
# "runs". Experts are most of the file and only a few of them are read per
# token, so the offloaded bulk costs bandwidth in proportion to the ACTIVE
# experts, not to its size. Measured on Ornith 1.5 35B-A3B: 19,098 MiB of
# experts against 1,599 MiB of everything else, 8 of 256 experts per token, so
# 597 MiB read per token instead of 20 GB.
#
# Set it as LOW as the card allows: every block you keep in VRAM is one whose
# experts are not read over the memory bus. `scripts/gguf-info.py` reports the
# per-block expert cost. What it buys and what it costs is EXPERIMENTS.md 13 --
# read the prefill numbers there before choosing this over a smaller model.
N_CPU_MOE=0
# KV cache quantization: q8_0 uses half of what f16 does, at usually negligible
# loss. Applies to both K and V unless one of the two below overrides it.
#
# "Usually" is doing work in that sentence. On a model with a small KV cache,
# f16 is measurably FASTER than q8_0 as well as exact, because the bandwidth
# saved is less than the dequantization added — +4% on Ornith 1.5 35B-A3B,
# whose cache is 11 of 41 blocks at head_count_kv 2. Benchmark rather than
# assume when gguf-info.py reports a cheap cache.
KV_TYPE=q8_0
#
# K and V are not equally sensitive: quantizing K hurts long-context retrieval
# noticeably, while V tolerates q4_0 much better. That argues for a mixed
# cache, and llama.cpp accepts one --
#
#     DO NOT USE IT. It is a silent 3x throughput collapse.
#
# The flash attention kernel has no path for mismatched K and V types and falls
# back to a generic one without logging anything. Measured on an RTX 3090,
# Ornith 1.5 35B-A3B, CTX=262144, -fa on:
#
#     KV_TYPE_K / KV_TYPE_V     prefill      decode
#     q8_0 / q8_0  (uniform)    3,252 t/s    161.4 t/s
#     q4_0 / q4_0  (uniform)    3,258 t/s    160.4 t/s
#     q8_0 / q4_0  (mixed)        244 t/s     58.9 t/s   <-- the "clever" one
#     f16  / q8_0  (mixed)        241 t/s     44.5 t/s
#
# The penalty is the mismatch, not the quantization level: q4_0 applied to both
# runs at full speed and costs 1,280 MiB less than q8_0 at 262k. So if you want
# the savings, take them by setting KV_TYPE uniformly -- never by splitting it.
# The server loads, reports healthy and answers correctly either way; only
# throughput tells you, and only if you measure. EXPERIMENTS.md section 11.4.
#
# Leave both unset to follow KV_TYPE. They exist for a future build that fixes
# this, and for backends other than CUDA flash attention.
#KV_TYPE_K=q8_0
#KV_TYPE_V=q8_0

# --- Sampling ---
# These are the values recommended for Qwen3. CAREFUL: they are model-specific.
# Ornith 1.0 35B, for instance, wants --temp 1.0 --top-k 0. Do not copy them
# between models without checking the model card.
TEMP=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0

# How reasoning is separated from the answer. "deepseek" sends the thinking
# block to a field of its own (reasoning_content) instead of leaving it in
# content.
REASONING_FORMAT=deepseek

# --- Throughput ---
# Host RAM (MiB) for the prompt cache: KV states of past conversations, kept so
# a client that comes back with a prompt it already sent does not pay to have it
# reprocessed. Purely a cache — what it stores is identical to what would be
# recomputed, so it cannot affect output quality, only latency.
# When it is full the server evicts the oldest entry and says so in the log:
#   srv alloc: - making room for prompt cache entry, removing oldest entry
# Size it against `free -g`, not against VRAM: this lives in system RAM, and
# overcommitting it trades a slow prefill for swapping, which is worse. An
# entry costs roughly (context length x KV bytes per token) — ~478 MiB for a
# 49k-token conversation at q8_0.
CACHE_RAM=10240

# Prompt batch sizes. llama.cpp's own defaults are 2048/512; anything lower
# throttles prefill for no benefit once every layer is on the GPU. Lower UBATCH
# only if the compute buffers push you out of VRAM.
BATCH=2048
UBATCH=512

# Speculative decoding. This model ships MTP heads (the blk.N.nextn.* tensors),
# so "draft-mtp" drafts with weights that are already loaded — no second model,
# no extra download. With any other --spec-type those tensors sit in VRAM
# unused and the server logs them as "unused tensor ... ignoring".
# Speculation is lossless: rejected drafts are discarded, so the text is exactly
# what the model would have produced on its own. It only ever costs time.
#   draft-mtp     use the model's own MTP heads (best here)
#   ngram-simple  no weights, drafts by repeating seen n-grams; weak on prose
#   none          disable
SPEC_TYPE=draft-mtp
# Tokens drafted per step. Higher pays off only when acceptance is high; each
# rejected token is wasted compute.
SPEC_N_MAX=8
# Confidence floor for keeping a drafted token. Lower drafts more aggressively.
SPEC_P_MIN=0.7

# An external drafter, in its own .gguf, for the case SPEC_TYPE alone cannot
# express. Leave BOTH EMPTY and the flags are not passed at all -- this is
# opt-in and costs nothing unused.
#
# Why it exists. The drafter a model ships is not always the best one available,
# and sometimes is not trained at all: the MTP head in Ornith 1.5 35B-A3B is
# reported by third parties to be random init (EXPERIMENTS.md 11.8). Trained
# replacements and DFlash heads are published separately, as files of 236-450 MB
# rather than tensors inside the model.
#
# Do NOT judge one by its download size. EXPERIMENTS.md 13.7 loaded a 236 MB
# DFlash head and measured it holding 2,048 MiB resident -- 8.7x the file, and
# MORE than the 1,266 MiB of the in-file draft-mtp path it was meant to
# undercut. The weights are never the expense; the drafter's own context and
# compute buffers are, and those scale with CTX and the batch, not with the
# head. Measure the VRAM after it loads.
#
# The file goes in MODELS_DIR beside the model. For a DFlash head set
# SPEC_TYPE=draft-dflash as well; for a grafted MTP head keep draft-mtp.
# DRAFT_NGL is the head's own GPU layer count -- leave empty to let llama.cpp
# decide, set 0 to keep the drafter on the CPU.
DRAFT_MODEL=
DRAFT_NGL=

# The address Docker publishes the port on.
#   127.0.0.1  -> this machine only (the default)
#   <tailscale IP, from `tailscale ip -4`> -> reachable from the whole tailnet
BIND=127.0.0.1

# Shared secret every request must present as `Authorization: Bearer <key>`.
# Empty means no authentication at all, which is the right default while the
# port is on loopback and the only way in is a tailnet the machines already
# trust.
#
# Set it before the server can be reached from anywhere less trusted -- a
# Cloudflare tunnel, an ngrok URL, a published port, a `tailscale funnel`. It is
# the server's ONLY access control: without it, whoever finds the address owns
# the GPU for as long as it is up.
#
# It is the standard OpenAI-compatible field, so clients need no special
# handling: `api_key=` in the SDKs, an API-key box in llama.cpp's own web UI.
# Generate one with `openssl rand -hex 24`. README section 7.
API_KEY=


# ==============================================================================
# Fill-in-the-middle server  (the `fim` compose profile)
# ==============================================================================
# A SECOND, independent server for editor autocompletion, on its own port and
# its own container. It shares nothing with the chat service above except the
# image and the read-only models directory, and it does not start with
# `serve.sh up` -- it is behind a compose profile. Drive it with:
#
#   ./scripts/serve.sh fim up | down | status | test | logs
#
# It must be a BASE model, not an instruct one. FIM works by feeding the model
# special tokens for prefix / suffix / middle, and only base checkpoints carry
# them. An instruct model on the same weights will answer the completion as if
# it were a chat turn, which reads as garbage in the middle of a function.
#
# The reference file here is qwen2.5-coder-1.5b-q8_0.gguf, 1.65 GB, Apache 2.0,
# from ggml-org/Qwen2.5-Coder-1.5B-Q8_0-GGUF. Q8 rather than Q4: at 1.5B the
# whole file is small either way, and completion quality is what is being paid
# for. See README section 8.
FIM_MODEL_FILE=qwen2.5-coder-1.5b-q8_0.gguf
FIM_MODEL_ALIAS=qwen25-coder-1.5b-fim
FIM_CONTAINER_NAME=llama-fim

# 8012 is the port the llama.vscode / llama.vim extensions default to, which is
# why it is not 8080+1.
FIM_PORT=8012
FIM_BIND=127.0.0.1

# 0 means the model's own training context (32,768 here), not "unlimited".
FIM_CTX=0
FIM_NGL=all

# Equal on purpose. A completion re-sends a whole window of surrounding code,
# so the request is prefill-bound; splitting the batch into smaller ubatches
# adds a pass and buys nothing.
FIM_BATCH=1024
FIM_UBATCH=1024

# How large a gap in the prompt prefix the server will tolerate while still
# reusing the KV cache it already has. This is the flag that makes typing feel
# instant instead of re-reading the file on every keystroke.
FIM_CACHE_REUSE=256
