# Ornith 1.5 35B-A3B on an RTX 3070 Laptop (8 GB) — MoE expert offload to host RAM
#
# A 20.2 GiB model on an 8 GiB card. It runs because the model is a mixture of
# experts: 92.3% of the file is expert tensors and only 8 of 256 experts are
# read per token, so the offloaded bulk costs bandwidth in proportion to what is
# ACTIVE, not to its size. Measured from the tensor index of this exact file:
#
#     expert tensors (*_exps)   19,098 MiB   92.3%   -> host RAM
#     everything else            1,599 MiB    7.7%   -> VRAM
#     per block                    466 MiB   (41 blocks)
#     8/256 active              ->  597 MiB read per token over the memory bus
#
# Host RAM read bandwidth measured here: 42.5 GB/s (DDR4 dual channel, 16
# threads). 597 MiB/token puts the hard decode ceiling at 68 t/s with every
# expert on the CPU.
#
# MEASURED, not estimated. 48.3 t/s decode and 213 t/s prefill at 7,178 of
# 8,192 MiB, against 162.6 / 3,271 for the same file on a dedicated RTX 3090
# (docs/profiles/ornith15-35b.env). Decode degrades 3.4x, prefill 15x -- that
# asymmetry is the thing to decide on, and EXPERIMENTS.md section 13 is the
# full write-up.

# --- Where the .gguf files live on the host ---
MODELS_DIR=/home/nromero/models

# --- Model ---
# ornith-ai/Ornith-1.5-35B-A3B-GGUF, 21,713,462,848 B. qwen35moe: 41 blocks,
# 256 experts, 8 active (~3B active parameters), 11 blocks with KV.
MODEL_FILE=Ornith-1.5-35B-Q4_K_M.gguf
MODEL_ALIAS=ornith15-35b
CONTAINER_NAME=ornith15-35b
PORT=8080

# --- MoE offload: the setting this whole profile exists for ---
# Experts of the first N blocks live in host RAM. Set it as LOW as the card
# allows: every block kept in VRAM is 466 MiB that does not cross the memory
# bus on every token.
#
# SWEPT, container recreated at every row. VRAM used / decode:
#
#     41 -> 2,826 MiB / 40.23 t/s      31 -> 7,178 MiB / 47.88 t/s   <- this
#     37 -> 4,320 MiB / 42.35 t/s      30 -> 7,610 MiB / 48.40 t/s
#     34 -> 5,816 MiB / 45.16 t/s      29 -> OOM
#
# 435 MiB and +0.77 t/s per block moved to the GPU. 30 is the fastest value
# that loads and 31 is the one to run: the last block buys 0.5% -- inside the
# noise band the controls established -- and takes the real headroom from
# 649 MiB to ~233.
#
# Read that headroom from `nvidia-smi --query-gpu=memory.free`, NOT as
# total - used: the two do not sum to total and the subtraction overstates what
# is available by ~350 MiB on this card. On this laptop the RTX also drives the
# external monitors, so the margin absorbs a monitor being plugged in, not only
# an allocation spike.
N_CPU_MOE=31

# --- Memory ---
# CTX is deliberately NOT the 262,144 that docs/profiles/ornith15-35b.env runs
# on the 3090. Not because the KV cache does not fit — at 13.6 KiB/token it
# nearly would — but because prefill runs on the CPU here and is roughly 25x
# slower. A 100k-token prompt would spend ~13 minutes before the first token.
# Context you cannot afford to fill is VRAM taken from the expert blocks, which
# is the one thing that makes decode faster.
CTX=65536
NGL=all

# q8_0, measured against f16 rather than assumed. EXPERIMENTS.md 11.3 found f16
# 4.7% FASTER on the 3090; here it is +1.2%, against a control band of 0.7%.
# The gain nearly vanished because the bottleneck left the GPU -- attention is
# no longer on the critical path, the memory bus is. And f16 costs 600 MiB,
# more than one block of experts: at equal VRAM it is 3.4% SLOWER. 13.4.
#
# Do NOT split KV_TYPE_K and KV_TYPE_V. Mismatched types silently fall off the
# flash attention fast path — 3.6x. EXPERIMENTS.md 11.4.
KV_TYPE=q8_0

# --- Sampling: read from the GGUF, not from the card ---
# general.sampling.temp 1.0 / top_k 20 / top_p 0.95. The model card's Python
# examples say temperature=0.6, but every benchmark reported in that same card
# was run at 1.0, and the file agrees with the benchmarks. EXPERIMENTS.md 11.1.
TEMP=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0.0
REASONING_FORMAT=deepseek

# --- Throughput ---
# Worth more here than anywhere else in this repo: prefill is on the CPU and
# costs ~25x what it does on a GPU, so every prompt prefix served from cache is
# a large saving rather than a small one. 62 GB of RAM, ~19 GB of it already
# holding the experts — check `free -g` before raising this.
CACHE_RAM=16384

# Left at the repo defaults. Prefill is CPU-compute-bound in this
# configuration, which is a regime neither experiment 2 (3090) nor experiment
# 10 (4090) covers, so these two are unmeasured here rather than chosen.
BATCH=2048
UBATCH=512

# --- Speculative decoding ---
# none, and now for a different reason than on the 3090. 11.2 measured
# draft-mtp 24% slower there and blamed the MoE token being too cheap for
# verification to amortize -- which predicts speculation should WIN here, where
# a token costs 597 MiB over the memory bus. It does not: -7.6% at 79.8%
# acceptance.
#
# The raw number understates it. draft-mtp took 1,266 MiB more, which is THREE
# BLOCKS of experts pushed back to the CPU. At equal VRAM:
#
#     draft-mtp, N_CPU_MOE=34   7,082 MiB   41.86 t/s
#     none,      N_CPU_MOE=31   7,178 MiB   47.88 t/s   <- 14.4% faster
#
# Where the card is the binding constraint, anything costing VRAM is charged
# twice: once for what it does, once for the expert blocks it evicts. A drafter
# at 80% acceptance is not bad -- it is paying rent it cannot cover. 13.3.
#
# The obvious escape -- a small published head instead of the in-file one --
# was tried and does not work. A 236 MB DFlash head holds 2,048 MiB resident,
# more than draft-mtp, and at equal VRAM still loses to not speculating;
# pinning it to the CPU costs 2.4x. THREE drafters measured on this config,
# all three worse than none. 13.7.
SPEC_TYPE=none
SPEC_N_MAX=8
SPEC_P_MIN=0.7

# --- Exposure ---
# Loopback only. No authentication anywhere in this stack. README section 7.
BIND=127.0.0.1
